API_URL=http://localhost:8000/graphql/
APP_MOUNT_URI=/
# Provides source for App Store / explore feature. Only for Saleor Cloud
# EXTENSIONS_API_URL=https://apps.saleor.io/api/v1/extensions
LOCALE_CODE="EN"

# Multi-schema support (optional)
# Set to "true" to use staging schema instead of main schema
# See docs/multi-schema.md
FF_USE_STAGING_SCHEMA=false

# TenxYou backend (REST). Root origin without a trailing path — the cache
# management module appends /saleor/... itself.
# local: http://localhost:4567
# staging: https://api.tenxyou.infinitelocus.com
# prod: https://api.tenxyou.com
VITE_TENEXU_API_URL=https://api.tenxyou.com
# Shared secret gating the bulk-order import endpoint
VITE_SALEOR_PRODUCT_PASSWORD=xxxx
# Optional. Bearer key for cache routes marked [Admin] (inventory stock seed).
# Leave unset to use the signed-in staff user's Saleor token instead.
VITE_TENEXU_ADMIN_API_KEY=

MAILPITURL=xxxx #For playwright

E2E_USER_NAME=xxxx
E2E_USER_PASSWORD=xxxx
E2E_PERMISSIONS_USERS_PASSWORD=xxxx
BASE_URL=http://localhost:9000/

ONBOARDING_USER_JOINED_DATE_THRESHOLD=2024-07-01
